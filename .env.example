# Copy to .env for local development. Never commit .env.
POSTGRES_USER=nirs
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=nirs
POSTGRES_PORT=55432
APP_PORT=8000
# Percent-encode special characters in the password when writing a URL.
DATABASE_URL=postgresql+psycopg://nirs:replace-with-local-password@127.0.0.1:55432/nirs

# Local model: host address for Python, Docker address for the container.
OLLAMA_URL=http://127.0.0.1:11434
DOCKER_OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TIMEOUT=90

GH_OWNER=alevkovskiy
GH_REPO=NIRS_VKR
GH_ACTIONS_TOKEN=
